<dita>
   <concept id="GSAM_514_203_1"
            audience="GSAR"
            class="- topic/topic concept/concept ">
      <title xtrc="GSAR" class="- topic/title "> 
         <ph props="autonumber" class="- topic/ph ">514.203-1</ph> Transmittal to prospective bidders.</title>
      <conbody class="- topic/body  concept/conbody ">
         <p audience="GSAR" class="- topic/p ">Prospective bidders, as used in FAR 14.203-1, include both the following:</p>
         <ol class="- topic/ol ">
            <li class="- topic/li ">
               <p class="- topic/p ">
                  <ph props="autonumber" class="- topic/ph ">(a)</ph> The incumbent contractor, except when its written response to the notice of contract action under FAR subpart 5.2 states a negative interest.</p>
            </li>
            <li class="- topic/li ">
               <p class="- topic/p ">
                  <ph props="autonumber" class="- topic/ph ">(b)</ph> Bidders that responded to recent solicitations for the same or similar items.</p>
            </li>
         </ol>
      </conbody>
   </concept>
</dita>
